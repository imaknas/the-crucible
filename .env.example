# The Crucible — Environment Variables
# Copy this file to .env and fill in your API keys.

# At least one of the following is required:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Frontend (optional — defaults to http://localhost:8000)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend bind address (optional — defaults to 127.0.0.1, loopback only).
# Exposing it on a network also exposes the unauthenticated API.
# HOST=127.0.0.1

# Extra browser origins allowed by CORS, comma-separated (optional).
# localhost / 127.0.0.1 on any port are always allowed.
# CORS_ORIGINS=https://crucible.example.com
